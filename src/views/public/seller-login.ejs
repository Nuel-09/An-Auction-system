<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      header {
        background-color: rgba(44, 62, 80, 0.95);
        color: white;
        padding: 20px;
        text-align: center;
      }

      header h1 {
        font-size: 24px;
        letter-spacing: 2px;
      }

      .container {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
      }

      .login-box {
        background: white;
        padding: 40px;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        max-width: 400px;
        width: 100%;
      }

      .login-box h2 {
        color: #2c3e50;
        margin-bottom: 10px;
        text-align: center;
      }

      .login-box p {
        color: #7f8c8d;
        text-align: center;
        margin-bottom: 30px;
        font-size: 14px;
      }

      .error {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
        padding: 15px;
        border-radius: 4px;
        margin-bottom: 20px;
        display: none;
      }

      .error.show {
        display: block;
      }

      .form-group {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
        color: #2c3e50;
      }

      input {
        width: 100%;
        padding: 12px;
        border: 1px solid #bdc3c7;
        border-radius: 4px;
        font-size: 14px;
        box-sizing: border-box;
      }

      input:focus {
        outline: none;
        border-color: #3498db;
        box-shadow: 0 0 5px rgba(52, 152, 219, 0.3);
      }

      .submit-btn {
        width: 100%;
        padding: 12px;
        background-color: #3498db;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.3s;
      }

      .submit-btn:hover {
        background-color: #2980b9;
      }

      .back-home {
        text-align: center;
        margin-top: 20px;
      }

      .back-home a {
        color: #3498db;
        text-decoration: none;
        font-size: 14px;
      }

      .back-home a:hover {
        text-decoration: underline;
      }

      footer {
        background-color: rgba(44, 62, 80, 0.95);
        color: white;
        text-align: center;
        padding: 20px;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <header>
      <div
        style="
          display: flex;
          align-items: center;
          justify-content: center;
          height: 60px;
        "
      >
        <img
          src="/public/images/logo.png"
          alt="Fotherbys Auction Houses"
          style="height: 50px; width: auto"
        />
      </div>
    </header>

    <div class="container">
      <div class="login-box">
        <h2>Access Your Submission</h2>
        <p>Enter the email address associated with your item submission</p>

        <% if (error) { %>
        <div class="error show"><%= error %></div>
        <% } %>

        <form id="loginForm">
          <div class="form-group">
            <label for="email">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
              autofocus
            />
          </div>

          <button type="submit" class="submit-btn">View My Items</button>
        </form>

        <div class="back-home">
          <a href="/">← Back to Home</a>
        </div>
      </div>
    </div>

    <footer>
      <p>&copy; 2026 Fotherbys Auction House. All rights reserved.</p>
    </footer>

    <script>
      document
        .getElementById("loginForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const email = document.getElementById("email").value;

          try {
            const response = await fetch("/api/public/seller/login", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email }),
            });

            const data = await response.json();
            if (response.ok) {
              window.location.href = data.data.redirectTo;
            } else {
              document.querySelector(".error").textContent =
                data.message || "Error";
              document.querySelector(".error").classList.add("show");
            }
          } catch (error) {
            document.querySelector(".error").textContent =
              "Error: " + error.message;
            document.querySelector(".error").classList.add("show");
          }
        });
    </script>
  </body>
</html>
