<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/dashboard.css" />
    <style>
      .detail-container {
        background: white;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
      }
      .detail-row {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 20px;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
      }
      .detail-label {
        font-weight: bold;
        color: #34495e;
      }
      .detail-value {
        color: #555;
      }
      .btn-primary {
        background-color: #3498db;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
      }
      .btn-primary:hover {
        background-color: #2980b9;
      }
      .btn-back {
        background-color: #95a5a6;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 20px;
      }
      .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 4px;
        font-weight: bold;
        color: white;
      }
      .status-draft {
        background-color: #ecf0f1;
        color: #34495e;
      }
      .status-submitted {
        background-color: #3498db;
      }
      .status-locked {
        background-color: #e74c3c;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      th,
      td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }
      th {
        background-color: #f5f5f5;
        font-weight: bold;
      }
      .actions {
        display: flex;
        gap: 10px;
      }
      .btn-small {
        padding: 6px 12px;
        font-size: 12px;
        text-decoration: none;
        border-radius: 3px;
        cursor: pointer;
        border: none;
      }
      .btn-view {
        background-color: #3498db;
        color: white;
      }
    </style>
  </head>
  <body>
    <div class="sidebar">
      <div class="logo">
        <h2>Fotherbys</h2>
      </div>
      <nav class="menu">
        <a href="/admin/leads" class="menu-item">Seller Leads</a>
        <a href="/admin/items" class="menu-item">Items</a>
        <a href="/admin/auctions" class="menu-item">Auctions</a>
        <a href="/admin/dashboard" class="menu-item">Dashboard</a>
      </nav>
      <div class="logout-section">
        <form method="POST" action="/admin/logout" style="width: 100%">
          <button type="submit" class="logout-btn">Logout</button>
        </form>
      </div>
    </div>

    <div class="main-content">
      <header class="top-bar">
        <div class="header-content">
          <h1><%= title %></h1>
          <div class="user-info">
            Logged in as: <strong><%= admin?.email %></strong>
          </div>
        </div>
      </header>

      <div class="content">
        <a href="/admin/leads" class="btn-back">← Back to Leads</a>

        <div class="detail-container">
          <h2><%= lead.name %></h2>

          <div class="detail-row">
            <div class="detail-label">Status</div>
            <div class="detail-value">
              <span class="status-badge status-<%= lead.status %>"
                ><%= lead.status %></span
              >
            </div>
          </div>

          <div class="detail-row">
            <div class="detail-label">Email</div>
            <div class="detail-value"><%= lead.email %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">Phone</div>
            <div class="detail-value"><%= lead.phone %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">Company</div>
            <div class="detail-value"><%= lead.companyName %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">Item Details</div>
            <div class="detail-value"><%= lead.itemDetails %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">Created</div>
            <div class="detail-value">
              <%= new Date(lead.createdAt).toLocaleString() %>
            </div>
          </div>

          <% if (lead.status === 'draft') { %>
          <div
            style="
              margin-top: 20px;
              padding-top: 20px;
              border-top: 1px solid #eee;
            "
          >
            <button
              onclick="updateStatus('submitted')"
              style="
                background-color: #3498db;
                color: white;
                padding: 10px 20px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
              "
            >
              Mark as Submitted
            </button>
          </div>
          <% } else if (lead.status === 'submitted') { %>
          <div
            style="
              margin-top: 20px;
              padding-top: 20px;
              border-top: 1px solid #eee;
            "
          >
            <button
              onclick="updateStatus('locked')"
              style="
                background-color: #27ae60;
                color: white;
                padding: 10px 20px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                margin-right: 10px;
              "
            >
              Verify & Lock
            </button>
            <button
              onclick="updateStatus('draft')"
              style="
                background-color: #e74c3c;
                color: white;
                padding: 10px 20px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
              "
            >
              Return for Revision
            </button>
          </div>
          <% } %>
        </div>

        <div class="detail-container">
          <h3>Items from this Lead</h3>
          <button
            onclick="loadLeadItems()"
            class="btn-primary"
            style="margin-bottom: 15px"
          >
            Load Items
          </button>
          <div id="itemsList"></div>
        </div>
      </div>
    </div>

    <script>
      async function loadLeadItems() {
        try {
          const response = await fetch("/api/leads/<%= lead._id %>/items");
          const data = await response.json();

          if (data.success && data.data.length > 0) {
            let html =
              "<table><thead><tr><th>Title</th><th>Description</th><th>Category</th><th>Estimate</th><th>Status</th></tr></thead><tbody>";
            data.data.forEach((item) => {
              html += `<tr>
              <td>${item.title}</td>
              <td>${item.description}</td>
              <td><strong>${item.category}</strong></td>
              <td>£${item.estimateMin} - £${item.estimateMax}</td>
              <td><span style="background: #3498db; color: white; padding: 4px 8px; border-radius: 3px;">${item.status}</span></td>
            </tr>`;
            });
            html += "</tbody></table>";
            document.getElementById("itemsList").innerHTML = html;
          } else {
            document.getElementById("itemsList").innerHTML =
              '<p style="color: #7f8c8d;">No items created from this lead yet.</p>';
          }
        } catch (error) {
          alert("Error loading items: " + error.message);
        }
      }

      async function updateStatus(newStatus) {
        try {
          const response = await fetch("/api/leads/<%= lead._id %>", {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            credentials: "include",
            body: JSON.stringify({ status: newStatus }),
          });

          if (response.ok) {
            alert("Status updated!");
            location.reload();
          } else {
            const error = await response.json();
            alert(
              "Failed to update status: " + (error.message || "Unknown error")
            );
          }
        } catch (error) {
          alert("Error: " + error.message);
        }
      }
    </script>
  </body>
</html>
