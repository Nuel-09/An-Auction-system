<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/dashboard.css" />
    <style>
      .detail-container {
        background: white;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
      }
      .detail-row {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 20px;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
      }
      .detail-label {
        font-weight: bold;
        color: #34495e;
      }
      .detail-value {
        color: #555;
      }
      .btn-primary {
        background-color: #3498db;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
      }
      .btn-primary:hover {
        background-color: #2980b9;
      }
      .btn-back {
        background-color: #95a5a6;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 20px;
      }
      .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 4px;
        font-weight: bold;
        color: white;
      }
      .status-draft {
        background-color: #ecf0f1;
        color: #34495e;
      }
      .status-published {
        background-color: #27ae60;
      }
      .status-closed {
        background-color: #e74c3c;
      }
      .btn-success {
        background-color: #27ae60;
        color: white;
      }
      .btn-success:hover {
        background-color: #229954;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th,
      td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }
      th {
        background-color: #f5f5f5;
        font-weight: bold;
      }
      .actions {
        display: flex;
        gap: 10px;
      }
      .btn-small {
        padding: 6px 12px;
        font-size: 12px;
        border-radius: 3px;
        border: none;
        cursor: pointer;
      }
      .btn-remove {
        background-color: #e74c3c;
        color: white;
      }
    </style>
  </head>
  <body>
    <div class="sidebar">
      <div class="logo">
        <h2>Fotherbys</h2>
      </div>
      <nav class="menu">
        <a href="/admin/leads" class="menu-item">Seller Leads</a>
        <a href="/admin/items" class="menu-item">Items</a>
        <a href="/admin/auctions" class="menu-item">Auctions</a>
        <a href="/admin/catalogue-preview" class="menu-item"
          >📋 Catalogue Preview</a
        >
        <a href="/admin/dashboard" class="menu-item">Dashboard</a>
      </nav>
      <div class="logout-section">
        <form method="POST" action="/admin/logout" style="width: 100%">
          <button type="submit" class="logout-btn">Logout</button>
        </form>
      </div>
    </div>

    <div class="main-content">
      <header class="top-bar">
        <div class="header-content">
          <h1><%= title %></h1>
          <div class="user-info">
            Logged in as: <strong><%= admin?.email %></strong>
          </div>
        </div>
      </header>

      <div class="content">
        <a href="/admin/auctions" class="btn-back">← Back to Auctions</a>

        <div class="detail-container">
          <h2><%= auction.title %></h2>

          <div class="detail-row">
            <div class="detail-label">Status</div>
            <div class="detail-value">
              <span class="status-badge status-<%= auction.status %>"
                ><%= auction.status %></span
              >
            </div>
          </div>

          <div class="detail-row">
            <div class="detail-label">Description</div>
            <div class="detail-value"><%= auction.description %></div>
          </div>

          <div class="detail-row">
            <div class="detail-label">Start Date</div>
            <div class="detail-value">
              <%= new Date(auction.startDate).toLocaleString() %>
            </div>
          </div>

          <div class="detail-row">
            <div class="detail-label">End Date</div>
            <div class="detail-value">
              <%= new Date(auction.endDate).toLocaleString() %>
            </div>
          </div>

          <div class="detail-row">
            <div class="detail-label">Created</div>
            <div class="detail-value">
              <%= new Date(auction.createdAt).toLocaleString() %>
            </div>
          </div>

          <% if (auction.status === 'draft') { %>
          <div
            style="
              margin-top: 20px;
              padding-top: 20px;
              border-top: 1px solid #eee;
            "
          >
            <button onclick="publishAuction()" class="btn-primary btn-success">
              Publish Auction
            </button>
          </div>
          <% } else if (auction.status === 'published') { %>
          <div
            style="
              margin-top: 20px;
              padding-top: 20px;
              border-top: 1px solid #eee;
            "
          >
            <button
              onclick="closeAuction()"
              class="btn-primary"
              style="background-color: #e74c3c"
            >
              Close Auction
            </button>
          </div>
          <% } %>
        </div>

        <div class="detail-container">
          <h3>Items in this Auction</h3>
          <p style="color: #7f8c8d; margin-bottom: 15px">
            Total items: <%= items.length %>
          </p>

          <% if (items && items.length > 0) { %>
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Estimate</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(item => { %>
              <tr>
                <td>
                  <a
                    href="/admin/items/<%= item._id %>"
                    style="color: #3498db; text-decoration: none"
                    ><%= item.title %></a
                  >
                </td>
                <td>£<%= item.estimateMin %> - £<%= item.estimateMax %></td>
                <td>
                  <span
                    style="
                      background: #3498db;
                      color: white;
                      padding: 4px 8px;
                      border-radius: 3px;
                    "
                    ><%= item.status %></span
                  >
                </td>
                <td>
                  <button
                    onclick="removeItemFromAuction('<%= item._id %>')"
                    class="btn-small btn-remove"
                  >
                    Remove
                  </button>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <p style="color: #7f8c8d; padding: 20px; text-align: center">
            No items in this auction yet. Assign items from the items page.
          </p>
          <% } %>
        </div>

        <div class="detail-container">
          <h3>Bulk Assign Items</h3>
          <p style="color: #7f8c8d; margin-bottom: 15px">
            Assign multiple items at once using their lot reference numbers
          </p>
          <div style="margin-bottom: 15px">
            <label>Paste Lot References (comma-separated):</label>
            <textarea
              id="itemIds"
              style="width: 100%; padding: 8px; height: 80px"
              placeholder="e.g., LOT-1768363290323-TXBDASYPS, LOT-1768363290323-BPEGABQ83"
            ></textarea>
          </div>
          <button onclick="bulkAssignItems()" class="btn-primary">
            Bulk Assign
          </button>
        </div>
      </div>
    </div>

    <script>
      async function publishAuction() {
        try {
          const response = await fetch(
            "/api/auctions/<%= auction._id %>/publish",
            { method: "POST" }
          );
          if (response.ok) {
            alert("Auction published!");
            location.reload();
          } else {
            alert("Failed to publish auction");
          }
        } catch (error) {
          alert("Error: " + error.message);
        }
      }

      async function closeAuction() {
        try {
          const response = await fetch(
            "/api/auctions/<%= auction._id %>/close",
            { method: "POST" }
          );
          if (response.ok) {
            alert("Auction closed!");
            location.reload();
          } else {
            alert("Failed to close auction");
          }
        } catch (error) {
          alert("Error: " + error.message);
        }
      }

      async function removeItemFromAuction(itemId) {
        if (!confirm("Remove this item from the auction?")) return;

        try {
          const response = await fetch(
            `/api/auctions/<%= auction._id %>/items/${itemId}`,
            {
              method: "DELETE",
            }
          );

          if (response.ok) {
            alert("Item removed!");
            location.reload();
          } else {
            alert("Failed to remove item");
          }
        } catch (error) {
          alert("Error: " + error.message);
        }
      }

      async function bulkAssignItems() {
        const itemIdsText = document.getElementById("itemIds").value;
        const itemIds = itemIdsText
          .split(",")
          .map((id) => id.trim())
          .filter((id) => id.length > 0);

        if (itemIds.length === 0) {
          alert("Please enter at least one item ID");
          return;
        }

        console.log("Bulk assigning items:", itemIds);

        try {
          const response = await fetch(
            "/api/auctions/<%= auction._id %>/items/bulk-assign",
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ itemIds }),
            }
          );

          if (response.ok) {
            const data = await response.json();
            alert(`${data.data.modifiedCount} items assigned!`);
            location.reload();
          } else {
            alert("Failed to assign items");
          }
        } catch (error) {
          alert("Error: " + error.message);
        }
      }
    </script>
  </body>
</html>
